<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fandesunstar.eship.mapper.ShipFavoriteMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.fandesunstar.eship.entity.ShipFavorite">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="ship_id" property="shipId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 查询用户收藏的船舶ID列表 -->
    <select id="selectShipIdsByUserId" resultType="java.lang.Long">
        SELECT ship_id FROM tb_ship_favorite
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- 检查是否已收藏 -->
    <select id="selectByUserIdAndShipId" resultMap="BaseResultMap">
        SELECT * FROM tb_ship_favorite
        WHERE user_id = #{userId} AND ship_id = #{shipId}
    </select>

    <!-- 取消收藏 -->
    <delete id="deleteByUserIdAndShipId">
        DELETE FROM tb_ship_favorite
        WHERE user_id = #{userId} AND ship_id = #{shipId}
    </delete>

</mapper>
