# 数据库配置示例
# 复制此文件为 .env 并填入实际配置

# PostgreSQL数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eship
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# 邮件服务配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email_here
MAIL_PASSWORD=your_email_auth_code_here

# JWT配置（可选）
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# 服务器配置
SERVER_PORT=3473
